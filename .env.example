# MongoDB connection used only by the separate Express API.
MONGODB_URI=mongodb://localhost:27017/meridian_academy
MONGODB_DATABASE=meridian_academy
MONGODB_TRANSACTIONS=false

# Separate frontend and API origins. Add the deployed frontend origin in production.
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:4000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Generate a unique secret with at least 32 characters. Never commit real values.
BETTER_AUTH_SECRET=replace-with-a-unique-secret-at-least-32-characters
# Production only: configure the shared parent domain if the app and API use sibling subdomains.
# BETTER_AUTH_COOKIE_DOMAIN=.example.com

# Optional first-run administrator bootstrap (password must be at least 12 characters).
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_NAME=School Administrator
ADMIN_EMAILS=admin@meridian.com

# Keep true only for the sample records rendered by the starter UI.
NEXT_PUBLIC_DEMO_MODE=true

# Set TRUST_PROXY=1 only when the API is behind a trusted reverse proxy.
TRUST_PROXY=0
